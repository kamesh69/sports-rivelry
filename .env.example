# Copy to .env.local for local dev: cp .env.example .env.local
# Add the same keys in Vercel → Project → Settings → Environment Variables

# Public site URL (production: https://thesportsrivalry.com)
NEXT_PUBLIC_SITE_URL=https://thesportsrivalry.com

# WordPress CMS origin (leave empty to use mock content only)
NEXT_PUBLIC_WORDPRESS_URL=https://cms.thesportsrivalry.com

# Shared secrets — generate with: openssl rand -base64 32
REVALIDATE_SECRET=replace-me
WORDPRESS_PREVIEW_SECRET=replace-me

# Used in WordPress wp-config.php (SR_REVALIDATE_ENDPOINT), not read by Next.js
WORDPRESS_REVALIDATE_ENDPOINT=https://thesportsrivalry.com/api/revalidate

# Supabase — storage, auth, and Fan Zone / polls data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public storage bucket name for media uploads (default: media)
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
